# ─────────────────────────────────────────────────────────────────────────────
# HungryHeads — environment variables (brief §14)
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-side only)
ANTHROPIC_API_KEY=

# Swiggy OAuth (granted post-approval; until then we use mock mode)
SWIGGY_CLIENT_ID=
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:3000/api/swiggy-oauth/callback
# Optional overrides (defaults are shown commented out)
# SWIGGY_OAUTH_AUTHORIZE_URL=https://mcp.swiggy.com/auth/authorize
# SWIGGY_OAUTH_TOKEN_URL=https://mcp.swiggy.com/auth/token
# SWIGGY_OAUTH_LOGOUT_URL=https://mcp.swiggy.com/auth/logout

# MCP mode — switch between fixture replies and live Swiggy MCP calls
# Allowed: mock | live
MCP_MODE=mock

# Public app URL (used in OG metadata and absolute redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional / Phase 3
WHATSAPP_CLOUD_API_TOKEN=
OPENAI_API_KEY=
